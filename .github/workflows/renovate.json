{
  "extends": ["config:base"],
  "packageRules": [
    {
      "matchUpdateTypes": ["minor", "patch"],
      "automerge": true
    },
    {
      "description": "Python is pinned to what pydantic-core ships wheels for; 3.15 broke uv sync",
      "matchManagers": ["pyenv"],
      "enabled": false
    },
    {
      "description": "Postgres major bumps need a dump/restore (the data dir moved in 18); do them by hand",
      "matchPackageNames": ["postgres", "pgvector/pgvector"],
      "matchUpdateTypes": ["major"],
      "enabled": false
    },
    {
      "matchPackagePatterns": ["*"],
      "groupName": "all dependencies",
      "schedule": ["every weekend"]
    }
  ],
  "prHourlyLimit": 2,
  "timezone": "Africa/Johannesburg",
  "ignorePaths": ["docs/**", "examples/**"]
}
