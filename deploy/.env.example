# Copy to deploy/.env on the host. Never commit the real file.
POSTGRES_PASSWORD=change-me
# Gemini API key from https://aistudio.google.com/apikey
GOOGLE_API_KEY=change-me
# Optional: BoardGameGeek app token for real box art. Register a
# non-commercial app at https://boardgamegeek.com/applications (approval
# can take a week), then create a token there. Empty = no BGG lookups.
# BGG_TOKEN=
# Pin image versions to roll back, e.g. API_TAG=0.1.7
# API_TAG=latest
# UI_TAG=latest
# Override a retired Gemini model without a code change, e.g.
# CHAT_MODEL=gemini-3.5-flash
# IMAGE_MODEL=gemini-3.1-flash-image
